<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.velik.fx.controller.MainController" styleClass="app-root">
    <top>
        <HBox styleClass="app-header" alignment="CENTER_LEFT" spacing="12">
            <VBox>
                <Label text="Velik" styleClass="app-title"/>
                <Label text="Система проката велосипедов" styleClass="app-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Обновить данные" onAction="#onRefresh" styleClass="button-header"/>
            <Button text="Статистика" onAction="#onOpenStatistics" styleClass="button-header"/>
        </HBox>
    </top>
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
            <Tab fx:id="rentalsTab" text="Заявки на аренду">
                <fx:include fx:id="rentals" source="rentals.fxml"/>
            </Tab>
            <Tab fx:id="clientsTab" text="Клиенты">
                <fx:include fx:id="clients" source="clients.fxml"/>
            </Tab>
            <Tab fx:id="bikesTab" text="Велосипеды">
                <fx:include fx:id="bikes" source="bikes.fxml"/>
            </Tab>
            <Tab fx:id="statisticsTab" text="Статистика">
                <fx:include fx:id="statistics" source="statistics.fxml"/>
            </Tab>
        </TabPane>
    </center>
    <bottom>
        <Label fx:id="statusLabel" styleClass="status-bar" maxWidth="Infinity"/>
    </bottom>
</BorderPane>
