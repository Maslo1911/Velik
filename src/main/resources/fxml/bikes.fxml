<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.velik.fx.controller.BikesController" styleClass="section" spacing="10">

    <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="8">
        <Button text="Добавить" onAction="#onAdd" styleClass="button-primary"/>
        <Button fx:id="editButton" text="Изменить" onAction="#onEdit"/>
        <Button fx:id="deleteButton" text="Удалить" onAction="#onDelete" styleClass="button-danger"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Поиск: модель, тип" prefWidth="280"/>
        <Button text="Сбросить" onAction="#onResetSearch"/>
    </HBox>

    <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.6">
        <TableView fx:id="table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="modelColumn" text="Модель" prefWidth="240"/>
                <TableColumn fx:id="typeColumn" text="Тип" prefWidth="130"/>
                <TableColumn fx:id="priceColumn" text="Цена за час" prefWidth="130" styleClass="column-numeric"/>
                <TableColumn fx:id="availableColumn" text="Состояние" prefWidth="110"/>
            </columns>
        </TableView>

        <!-- Связанные данные: аренды выбранного велосипеда -->
        <VBox styleClass="details-pane" spacing="10" minWidth="260">
            <Label fx:id="relatedTitle" styleClass="section-title" wrapText="true"/>
            <ListView fx:id="rentalsList" VBox.vgrow="ALWAYS"/>
        </VBox>
    </SplitPane>

    <Label fx:id="countLabel" styleClass="muted"/>
</VBox>
